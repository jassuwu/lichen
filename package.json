{
  "name": "lichen",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run src/build.ts",
    "check": "bun run src/build.ts --check",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "package": "cd ports/vscode && bunx --bun @vscode/vsce package --no-dependencies",
    "publish:marketplace": "cd ports/vscode && bunx --bun @vscode/vsce publish --no-dependencies",
    "publish:openvsx": "cd ports/vscode && bunx ovsx publish --no-dependencies"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/bun": "^1.4.0"
  }
}
