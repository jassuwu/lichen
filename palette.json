{
  "name": "lichen",
  "roles": {
    "base":                { "oklch": [0.11, 0, 0],            "meaning": "the editor and terminal background; the darkest thing on screen" },
    "surface":             { "oklch": [0.17, 0, 0],            "meaning": "panels on base: sidebars, statusline, tab bar, inactive splits, cursor line" },
    "overlay":             { "oklch": [0.23, 0, 0],            "meaning": "things that float or are chosen: popups, menus, floating windows, selection, the box behind strings" },
    "border":              { "oklch": [0.31, 0, 0],            "meaning": "lines, not areas: split separators, float borders, indent guides" },
    "muted":               { "oklch": [0.53, 0, 0],            "meaning": "text that recedes: comments, line numbers, operators, punctuation, hints" },
    "subtle":              { "oklch": [0.69, 0, 0],            "meaning": "text that supports: keywords, decorators, builtin literals, secondary ui, info" },
    "text":                { "oklch": [0.85, 0, 0],            "meaning": "text that carries meaning: identifiers, properties, parameters, ui default" },
    "bright":              { "oklch": [0.97, 0, 0],            "meaning": "text that is exactly what it says: types, classes, jsx tags, numbers, strings; the lightest step" },
    "accent":              { "oklch": [0.9392, 0.1588, 124.39], "meaning": "the lime, invariant. a point, never an area: cursor, prompt char, active indicator, search fill, matching bracket, function names" },
    "accent-quiet":        { "oklch": [0.80, 0.07, 124.39],    "meaning": "the lime desaturated: diff added, links, git-new" },
    "on-accent":           { "oklch": [0.145, 0, 0],           "meaning": "text on an accent fill" },
    "error":               { "oklch": [0.70, 0.13, 22],        "meaning": "red: errors, diff deleted, failed tests; the loudest colour permitted" },
    "error-bright":        { "oklch": [0.78, 0.13, 22],        "meaning": "error, lighter; ansi 9" },
    "warning":             { "oklch": [0.80, 0.11, 82],        "meaning": "amber: warnings, diff changed, git modified" },
    "warning-bright":      { "oklch": [0.86, 0.11, 82],        "meaning": "warning, lighter; ansi 11" },
    "blue-tint":           { "oklch": [0.69, 0.03, 260],       "meaning": "ansi 4: a grey leaning blue, so terminal programs keep their categories" },
    "blue-tint-bright":    { "oklch": [0.85, 0.03, 260],       "meaning": "ansi 12" },
    "magenta-tint":        { "oklch": [0.69, 0.03, 330],       "meaning": "ansi 5: a grey leaning magenta" },
    "magenta-tint-bright": { "oklch": [0.85, 0.03, 330],       "meaning": "ansi 13" },
    "cyan-tint":           { "oklch": [0.69, 0.03, 200],       "meaning": "ansi 6: a grey leaning cyan" },
    "cyan-tint-bright":    { "oklch": [0.85, 0.03, 200],       "meaning": "ansi 14" }
  },
  "ansi": ["surface", "error", "accent-quiet", "warning", "blue-tint", "magenta-tint", "cyan-tint", "text",
           "muted", "error-bright", "accent", "warning-bright", "blue-tint-bright", "magenta-tint-bright", "cyan-tint-bright", "bright"],
  "syntax": {
    "function":            { "role": "accent" },
    "function-definition": { "role": "accent", "bold": true },
    "type":                { "role": "bright" },
    "type-definition":     { "role": "bright", "bold": true },
    "identifier":          { "role": "text" },
    "property":            { "role": "text" },
    "parameter":           { "role": "text", "italic": true },
    "constant":            { "role": "text", "bold": true },
    "number":              { "role": "bright" },
    "boolean":             { "role": "bright" },
    "keyword":             { "role": "subtle", "italic": true },
    "decorator":           { "role": "subtle", "italic": true },
    "builtin":             { "role": "subtle", "italic": true },
    "string":              { "role": "bright", "background": "overlay" },
    "string-escape":       { "role": "subtle", "background": "overlay" },
    "regexp":              { "role": "text", "background": "overlay" },
    "operator":            { "role": "muted" },
    "punctuation":         { "role": "muted" },
    "comment":             { "role": "muted", "italic": true }
  },
  "diff": {
    "added":   { "role": "accent-quiet", "mix": 0.12 },
    "deleted": { "role": "error",        "mix": 0.14 },
    "changed": { "role": "warning",      "mix": 0.12 }
  }
}
