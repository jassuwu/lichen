      "bold": true,
      "italic": false
    },
    "namespace": "#cecece",
    "variable": "#cecece",
    "property": "#cecece",
    "enumMember": "#cecece",
    "parameter": {
      "foreground": "#cecece",
      "bold": false,
      "italic": true
    },
    "keyword": {
      "foreground": "#9b9b9b",
      "bold": false,
      "italic": true
    },
    "decorator": {
      "foreground": "#9b9b9b",
      "bold": false,
      "italic": true
    },
    "macro": {
      "foreground": "#9b9b9b",
      "bold": false,
      "italic": true
    },
    "variable.defaultLibrary": {
      "foreground": "#9b9b9b",
      "bold": false,
      "italic": true
    },
    "comment": {
