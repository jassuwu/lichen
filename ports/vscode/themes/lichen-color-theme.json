  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6c6c6c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#9b9b9b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "decorator",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#9b9b9b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "builtin",
      "scope": [
        "variable.language",
        "support.variable",
        "support.constant"
      ],
      "settings": {
        "foreground": "#9b9b9b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "punctuation.definition.string",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.tag punctuation.definition.tag",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#6c6c6c"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.template",
        "meta.embedded.line"
      ],
      "settings": {
        "foreground": "#f5f5f5"
      }
    },
    {
      "name": "regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "string escape",
      "scope": [
        "constant.character.escape",
        "string.regexp keyword",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#9b9b9b"
      }
    },
    {
      "name": "template expression",
      "scope": [
        "meta.template.expression",
        "meta.embedded.expression"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f5f5f5"
      }
    },
    {
      "name": "boolean and null",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#f5f5f5"
      }
    },
    {
      "name": "constant",
      "scope": [
        "variable.other.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#cecece",
        "fontStyle": "bold"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "entity.name.function.member",
        "support.function.builtin",
        "entity.name.function.macro"
      ],
      "settings": {
        "foreground": "#d4fd80"
      }
    },
    {
      "name": "function definition",
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.method.declaration entity.name.function",
        "meta.function.declaration entity.name.function"
      ],
      "settings": {
        "foreground": "#d4fd80",
        "fontStyle": "bold"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "meta.type",
        "support.type.primitive",
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#f5f5f5"
      }
    },
    {
      "name": "type definition",
      "scope": [
        "meta.class entity.name.type.class",
        "meta.interface entity.name.type.interface",
        "meta.enum.declaration entity.name.type.enum",
        "meta.type.declaration entity.name.type.alias",
        "entity.name.type.alias"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#cecece",
        "fontStyle": "italic"
      }
    },
    {
      "name": "variable and property",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.other.attribute-name",
        "entity.name.variable",
        "support.variable.property",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "markup heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f5f5f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "markup bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "markup italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "markup link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#b4c695",
        "fontStyle": "underline"
      }
    },
    {
      "name": "markup code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "markup list",
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#6c6c6c"
      }
    },
    {
      "name": "diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#b4c695"
      }
    },
    {
      "name": "diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#e47b79"
      }
    },
    {
      "name": "diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#e1b767"
      }
    },
    {
      "name": "invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e47b79"
      }
    },
    {
      "name": "deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#6c6c6c",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "css property / selector",
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "css value",
      "scope": [
        "support.constant.property-value.css",
        "constant.other.color"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    },
    {
      "name": "json key",
      "scope": [
        "support.type.property-name.json",
        "meta.structure.dictionary.key"
      ],
      "settings": {
        "foreground": "#cecece"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#d4fd80",
    "method": "#d4fd80",
    "function.defaultLibrary": "#d4fd80",
    "function.declaration": {
      "foreground": "#d4fd80",
      "bold": true,
      "italic": false
    },
    "method.declaration": {
      "foreground": "#d4fd80",
      "bold": true,
      "italic": false
    },
    "class": "#f5f5f5",
    "type": "#f5f5f5",
    "interface": "#f5f5f5",
    "enum": "#f5f5f5",
    "struct": "#f5f5f5",
    "typeParameter": "#f5f5f5",
    "class.declaration": {
      "foreground": "#f5f5f5",
      "bold": true,
      "italic": false
    },
    "interface.declaration": {
